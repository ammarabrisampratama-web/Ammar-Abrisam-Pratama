        "mediaUrls": { "type": "array" },
        "mediaNames": { "type": "array" },
        "mediaDurationSec": { "type": "number" },
        "replyTo": { "type": ["object", "null"] },
        "forwardedFrom": { "type": "string", "maxLength": 100 },
        "reactions": { "type": "object" },
        "readBy": { "type": "array" },
        "deleted": { "type": "boolean" },
        "moderatedBy": { "type": "string", "maxLength": 80 },
        "editedAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "classId", "senderId", "senderName", "senderRole", "senderPhoto", "messageType", "text", "mediaUrls", "mediaNames", "mediaDurationSec", "replyTo", "forwardedFrom", "reactions", "readBy", "deleted", "moderatedBy", "editedAt", "createdAt"]
    },
    "TypingIndicator": {
      "title": "TypingIndicator",
