        "action": { "type": "string", "minLength": 2, "maxLength": 80 },
        "targetCollection": { "type": "string", "minLength": 2, "maxLength": 60 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "actorId", "actorName", "actorRole", "action", "targetCollection", "detail", "createdAt"]
    },
    "ClassSettings": {
      "title": "ClassSettings",
      "description": "Class and application configuration managed by Owner.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "enum": ["6A"] },
        "homeroomTeacher": { "type": "string", "minLength": 2, "maxLength": 80 },
        "academicYear": { "type": "string", "minLength": 4, "maxLength": 30 },
        "motto": { "type": "string", "maxLength": 160 },
        "adminContactNote": { "type": "string", "maxLength": 160 },
        "weeklyKasTarget": { "type": "number" },
        "allowStudentCreateTask": { "type": "boolean" },
        "allowStudentCreateAgenda": { "type": "boolean" },
        "allowAdminManageTreasury": { "type": "boolean" },
        "allowAdminManageSchedule": { "type": "boolean" },
        "whatsappGroupUrl": { "type": "string", "maxLength": 300 },
        "allowGameCenter": { "type": "boolean" },
        "allowVoiceNotes": { "type": "boolean" },
        "allowMediaUpload": { "type": "boolean" },
        "allowPrivateChat": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "homeroomTeacher", "academicYear", "motto", "adminContactNote", "weeklyKasTarget", "allowStudentCreateTask", "allowStudentCreateAgenda", "allowAdminManageTreasury", "allowAdminManageSchedule", "updatedAt"]
    }
  },
