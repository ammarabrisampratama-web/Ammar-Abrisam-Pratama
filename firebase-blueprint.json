{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public class member profile without PII (email isolated in users_private).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "nickname": { "type": "string", "minLength": 1, "maxLength": 40 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "absenNumber": { "type": "integer" },
        "role": { "type": "string", "enum": ["owner", "admin", "siswa"] },
        "status": { "type": "string", "enum": ["aktif", "nonaktif"] },
        "classId": { "type": "string", "enum": ["6A"] },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "bio": { "type": "string", "maxLength": 200 },
        "gameIds": { "type": "object" },
        "hideOnlineStatus": { "type": "boolean" }
      },
      "required": ["uid", "displayName", "nickname", "photoURL", "absenNumber", "role", "status", "classId", "lastLoginAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private PII record containing email and login timestamps, accessible only to self and Owner.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "lastLoginAt"]
    },
    "UserPresence": {
      "title": "UserPresence",
      "description": "Real-time online status and last seen indicator respecting privacy toggle.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "isOnline": { "type": "boolean" },
        "hideOnlineStatus": { "type": "boolean" },
        "lastSeenAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "isOnline", "hideOnlineStatus", "lastSeenAt"]
    },
    "BlockedUser": {
      "title": "BlockedUser",
      "description": "Personal block list entry under users_private/{uid}/blocked_users.",
      "type": "object",
      "properties": {
        "targetUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "targetName": { "type": "string", "maxLength": 80 },
        "blockedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetUid", "targetName", "blockedAt"]
    },
    "TaskProgress": {
      "title": "TaskProgress",
      "description": "Per-student progress state for an assignment.",
      "type": "object",
      "properties": {
        "taskId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "completed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["belum", "sedang", "selesai"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["taskId", "uid", "completed", "status", "updatedAt"]
    },
    "NotificationState": {
      "title": "NotificationState",
      "description": "Per-user notification read cursor.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "readIds": { "type": "array" },
        "lastReadAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "readIds", "lastReadAt"]
    },
    "LoginHistory": {
      "title": "LoginHistory",
      "description": "Audit log of sign-in events, readable strictly by Owner.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["owner", "admin", "siswa"] },
        "deviceInfo": { "type": "string", "minLength": 1, "maxLength": 160 },
        "loggedInAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "deviceInfo", "loggedInAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Class-wide announcement published by Owner or Admin.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "enum": ["6A"] },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "content": { "type": "string", "minLength": 3, "maxLength": 2000 },
        "category": { "type": "string", "enum": ["Penting", "Akademik", "Kegiatan", "Umum"] },
        "priority": { "type": "string", "enum": ["normal", "penting", "mendesak"] },
        "pinned": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "authorId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "authorRole": { "type": "string", "enum": ["owner", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "title", "content", "category", "priority", "pinned", "archived", "authorId", "authorName", "authorRole", "createdAt", "updatedAt"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "School homework assignment for Kelas 6A.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "enum": ["6A"] },
        "subject": { "type": "string", "minLength": 2, "maxLength": 60 },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "assignedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "dueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "priority": { "type": "string", "enum": ["rendah", "sedang", "tinggi"] },
        "authorId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "authorRole": { "type": "string", "enum": ["owner", "admin", "siswa"] },
        "editHistory": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "subject", "title", "description", "assignedDate", "dueDate", "priority", "authorId", "authorName", "authorRole", "editHistory", "createdAt", "updatedAt"]
    },
    "ScheduleItem": {
      "title": "ScheduleItem",
      "description": "Weekly class lesson schedule entry.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "enum": ["6A"] },
        "day": { "type": "string", "enum": ["Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"] },
        "order": { "type": "integer" },
        "startTime": { "type": "string", "maxLength": 5 },
        "endTime": { "type": "string", "maxLength": 5 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 60 },
        "teacher": { "type": "string", "maxLength": 80 },
        "room": { "type": "string", "maxLength": 40 },
        "authorId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "day", "order", "startTime", "endTime", "subject", "teacher", "room", "authorId", "updatedAt"]
    },
    "PicketScheduleItem": {
      "title": "PicketScheduleItem",
      "description": "Daily classroom cleaning & duty schedule (Senin-Sabtu).",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "enum": ["6A"] },
        "day": { "type": "string", "enum": ["Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"] },
        "students": { "type": "array" },
        "tasks": { "type": "array" },
        "coordinator": { "type": "string", "maxLength": 80 },
        "note": { "type": "string", "maxLength": 200 },
        "updatedById": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "day", "students", "tasks", "coordinator", "note", "updatedById", "updatedAt"]
    },
    "AgendaItem": {
      "title": "AgendaItem",
      "description": "Upcoming or completed class event or agenda item.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "enum": ["6A"] },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "eventDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "eventTime": { "type": "string", "maxLength": 5 },
        "location": { "type": "string", "minLength": 2, "maxLength": 100 },
        "status": { "type": "string", "enum": ["mendatang", "selesai"] },
        "authorId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "title", "description", "eventDate", "eventTime", "location", "status", "authorId", "authorName", "createdAt", "updatedAt"]
    },
    "TreasuryEntry": {
      "title": "TreasuryEntry",
      "description": "Class cash ledger entry (Uang Kas) with audit correction support.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "enum": ["6A"] },
        "type": { "type": "string", "enum": ["pemasukan", "pengeluaran"] },
        "amount": { "type": "number" },
        "description": { "type": "string", "minLength": 3, "maxLength": 160 },
        "category": { "type": "string", "enum": ["Iuran Kas", "Donasi", "Perlengkapan", "Kegiatan", "Lainnya"] },
        "studentName": { "type": "string", "maxLength": 80 },
        "paymentStatus": { "type": "string", "enum": ["lunas", "belum", "operasional"] },
        "correctionNote": { "type": "string", "maxLength": 240 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "recordedById": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "recordedByName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "type", "amount", "description", "category", "studentName", "paymentStatus", "correctionNote", "date", "recordedById", "recordedByName", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Legacy real-time class group chat message.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "enum": ["6A"] },
        "senderId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "senderRole": { "type": "string", "enum": ["owner", "admin", "siswa"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "senderId", "senderName", "senderRole", "text", "createdAt"]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "Chat room metadata for class group, custom groups, game rooms, and 1-on-1 DMs.",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "classId": { "type": "string", "enum": ["6A"] },
        "type": { "type": "string", "enum": ["class", "group", "game", "dm"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
