      "required": ["roomId", "classId", "type", "name", "description", "gameId", "participantIds", "pinnedMessageId", "pinnedText", "pinnedByName", "lastMessageText", "lastMessageSenderId", "lastMessageAt", "createdBy", "updatedAt"]
    },
    "RoomChatMessage": {
      "title": "RoomChatMessage",
      "description": "WhatsApp-style rich chat message supporting text, images, video, audio voice notes, replies, edits, reactions, and read receipts.",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "classId": { "type": "string", "enum": ["6A"] },
        "senderId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "senderName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "senderRole": { "type": "string", "enum": ["owner", "admin", "siswa"] },
        "senderPhoto": { "type": "string", "maxLength": 1000 },
        "messageType": { "type": "string", "enum": ["text", "image", "video", "audio"] },
