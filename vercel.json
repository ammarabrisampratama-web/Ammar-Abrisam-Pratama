{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://kelas-6a-43640.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://kelas-6a-43640.firebaseapp.com/__/firebase/init.json"
    },
    {
      "source": "/((?!api/|__/auth/|__/firebase/|assets/|src/assets/).*)",
      "destination": "/index.html"
    }
  ]
}
